	(text "RAIL DISCIPLINE: every bias references +3V3 or GND, never 5 V (GPIO26/27 are not fault-tolerant). R_PE to +5V_XCVR is the one deliberate exception."
		(exclude_from_sim no)
		(at 40.894 31.75 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0ced87c5-278e-48ce-bad9-d123a16b6027")
	)
	(text "+5V_XCVR arrives already gated from page 2 (Q1, on only when +3V3 is good). U3/U4 present no bus load while unpowered - SLLS004B/005B."
		(exclude_from_sim no)
		(at 40.64 36.83 0)
		(effects
